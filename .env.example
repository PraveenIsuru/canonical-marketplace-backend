APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000

# Search. Scout drives product indexing and the buyer keyword fallback path.
# MEILISEARCH_KEY must be the *admin* key: Scout creates indexes and writes documents,
# which a search-only key cannot do.
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=
MEILISEARCH_KEY=

# AI_PROVIDER picks which adapter answers: fake, anthropic, or gemini. Only the keys
# for the chosen one need filling in. Changing it needs a config:clear and a queue
# worker restart, because a running worker holds the old value.
AI_PROVIDER=fake
AI_FAKE_SHOULD_FAIL=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Shared by both providers, and short on purpose. Buyer search degrades to keyword
# results when the provider does not answer in time, so waiting longer only delays the
# fallback the shopper was going to get anyway.
AI_TIMEOUT_SECONDS=5

GEOCODING_PROVIDER=fake
GEOCODING_FAKE_SHOULD_FAIL=false
LOCATIONIQ_API_KEY=
GEOCODING_TIMEOUT_SECONDS=5
ALERT_NEARBY_RADIUS_KM=25

# M12. The revalidation webhook (EP-51). Must match REVALIDATE_SECRET in the frontend.
REVALIDATE_SECRET=change-me-in-local-and-production
REVALIDATE_ENABLED=true

# M12. Catalogue response caching. Set CATALOGUE_CACHE_STORE=redis to move it off the
# default store without moving sessions or anything else.
CATALOGUE_CACHE_ENABLED=true

# M12. Where a failing maintenance:health check is emailed. Unset emails every
# administrator account instead.
HEALTH_NOTIFY_EMAIL=

# M12. Where Horizon emails long wait and failure notices. Unset keeps Horizon quiet.
HORIZON_NOTIFICATION_EMAIL=
